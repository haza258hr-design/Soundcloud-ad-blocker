{
  "manifest_version": 3,
  "name": "SoundCloud Mid-Roll Guard",
  "version": "1.2.0",
  "minimum_chrome_version": "120",
  "description": "Blocks SoundCloud audio-ad requests, with ad-only mute and available-skip fallback.",
  "permissions": ["storage", "declarativeNetRequest", "webRequest", "alarms"],
  "host_permissions": [
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "https://*.sndcdn.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*", "https://*.soundcloud.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [{ "id": "audio_ads", "enabled": true, "path": "rules.json" }]
  },
  "action": {
    "default_title": "SoundCloud Mid-Roll Guard",
    "default_popup": "popup.html"
  }
}
